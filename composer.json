{
    "name": "eheuristic/laravel-log-monitor",
    "description": "Monitor Laravel daily log files and send error notifications via email",
    "type": "library",
    "keywords": [
        "laravel",
        "log",
        "monitor",
        "email",
        "error",
        "notification",
        "logging"
    ],
    "license": "MIT",
    "homepage": "https://github.com/eheuristic/laravel-log-monitor",
    "support": {
        "issues": "https://github.com/eheuristic/laravel-log-monitor/issues",
        "source": "https://github.com/eheuristic/laravel-log-monitor"
    },
    "authors": [
        {
            "name": "Shyam Baldha",
            "email": "shyam.b@eheuristic.com"
        },
        {
            "name": "Girish Mulchandani",
            "email": "girish@eheuristic.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/mail": "^8.0|^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Eheuristic\\LaravelLogMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eheuristic\\LaravelLogMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eheuristic\\LaravelLogMonitor\\LogMonitorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}